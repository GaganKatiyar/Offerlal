{
  "_comment": "Copy this file to appsettings.Development.Local.json (gitignored) and fill in real values. Without it, verification and password-reset emails are logged to the console instead of sent — see Email/LoggingEmailSender.cs.",

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "your-gmail-address@gmail.com",
    "_appPasswordHelp": "NOT your normal Gmail password. Turn on 2-Step Verification at myaccount.google.com/security, then generate a 16-character App Password at myaccount.google.com/apppasswords and paste it below with no spaces.",
    "AppPassword": "xxxxxxxxxxxxxxxx",
    "FromAddress": "your-gmail-address@gmail.com",
    "FromName": "Offerlal Fashion"
  },

  "_razorpayComment": "Test keys are free and instant from dashboard.razorpay.com (Settings > API Keys) and are prefixed rzp_test_. WebhookSecret is set separately under Settings > Webhooks and is NOT the key secret - the two are easy to confuse and using the wrong one rejects every webhook.",
  "Razorpay": {
    "KeyId": "rzp_test_xxxxxxxxxxxxxx",
    "KeySecret": "xxxxxxxxxxxxxxxxxxxxxxxx",
    "WebhookSecret": "whatever-you-typed-into-the-dashboard"
  }
}
